rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Fields: uid, email, role, displayName
    //
    // Collection: subjects
    // Fields: id, name, class
    //
    // Collection: questions
    // Fields: id, subjectId, topicId, text, type, difficulty, marks, options, correctAnswer, explanation
    //
    // Collection: papers
    // Fields: id, title, subjectId, teacherId, questions, totalMarks, duration, createdAt, scheduledAt
    //
    // Collection: results
    // Fields: id, paperId, studentId, score, answers, feedback, submittedAt
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "diptesh1298@gmail.com" && request.auth.token.email_verified == true));
    }
    function isTeacher() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    function isStudent() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid) && 
        request.resource.data.keys().hasAll(['uid', 'email', 'role']) &&
        request.resource.data.role in ['teacher', 'student', 'admin'];
    }

    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isTeacher();
    }

    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isTeacher();
    }

    match /papers/{paperId} {
      allow read: if isAuthenticated();
      allow create, update: if isTeacher() || isAdmin();
      allow delete: if isAdmin();
    }

    match /results/{resultId} {
      allow read: if isOwner(resource.data.studentId) || isTeacher() || isAdmin();
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
